# /etc/ascend/servers.env — read by ascend-servers.service (EnvironmentFile).
# chmod 600 this file: it contains your master key and admin password.
# systemd EnvironmentFile is NOT a shell file: no quotes, no $(), no export, no ;.

# Address advertised to players. Bare IP works (self-signed WebTransport cert is
# used automatically, browsers accept it via serverCertificateHashes). With a
# domain, set the FQDN and point an A record at the box.
PUBLIC_HOST=203.0.113.10

# Master server that lists this box in players' server lists. Same host:port as
# the master unit. Leave unset to run without a master (LAN/DHT discovery only).
MASTER_URL=http://203.0.113.10:8787

# Must equal MASTER_KEY in /etc/ascend/master.env, or announces get 403.
MASTER_KEY=replace-me-with-openssl-rand-hex-24

# Enables in-game admin commands (Esc -> Admin: map <id>, kick <name>, bots <n>, end).
ADMIN_PASSWORD=change-me

# A VPS has no router: skip port mapping, LAN multicast and DHT entirely.
AR_UPNP=0
AR_LAN=0
AR_DHT=0
# No node with --no-node, so relaying is moot.
AR_RELAY=0

# Where imported original maps live (default: <repo>/maps-original).
# AR_MAPS_ORIGINAL=/data/maps-original

# Only needed if you own a real certificate for PUBLIC_HOST (then certHash is null
# and WebTransport uses the real PKI). Leave unset for the self-signed 13-day cert.
# CERT_FILE=/etc/ascend/tls/fullchain.pem
# KEY_FILE=/etc/ascend/tls/privkey.pem
